{
  "name": "biomni-mcp-integration",
  "displayName": "Biomni MCP Integration",
  "description": "VSCode extension for Biomni MCP integration with intelligent code assistance",
  "version": "0.0.1",
  "publisher": "biomni",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "biomni",
    "mcp",
    "ai",
    "assistant",
    "code-intelligence"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "biomni.activate",
        "title": "Activate Biomni MCP Integration",
        "category": "Biomni"
      },
      {
        "command": "biomni.deactivate",
        "title": "Deactivate Biomni MCP Integration",
        "category": "Biomni"
      }
    ],
    "configuration": {
      "title": "Biomni MCP Integration",
      "properties": {
        "biomni.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Biomni MCP integration"
        },
        "biomni.mcpServerUrl": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "MCP server URL"
        },
        "biomni.autoActivate": {
          "type": "boolean",
          "default": true,
          "description": "Automatically activate extension on workspace open"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "package": "vsce package",
    "build": "npm run compile",
    "dev": "npm run watch"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "20.x",
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^2.26.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/manu-tej/epic-vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/manu-tej/epic-vscode-extension/issues"
  },
  "homepage": "https://github.com/manu-tej/epic-vscode-extension#readme"
}