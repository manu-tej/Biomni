{
  "name": "biomni-mcp-integration",
  "displayName": "Biomni MCP Integration",
  "description": "VSCode extension for Biomni MCP integration with intelligent code assistance",
  "version": "0.0.1",
  "publisher": "biomni",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "biomni",
    "mcp",
    "ai",
    "assistant",
    "code-intelligence"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "fasta",
        "aliases": [
          "FASTA",
          "fasta"
        ],
        "extensions": [
          ".fasta",
          ".fa",
          ".fas",
          ".seq",
          ".fna",
          ".ffn",
          ".frn"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "fastq",
        "aliases": [
          "FASTQ",
          "fastq"
        ],
        "extensions": [
          ".fastq",
          ".fq"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "vcf",
        "aliases": [
          "VCF",
          "vcf"
        ],
        "extensions": [
          ".vcf"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fasta",
        "scopeName": "source.fasta",
        "path": "./syntaxes/fasta.tmLanguage.json"
      },
      {
        "language": "fastq",
        "scopeName": "source.fastq",
        "path": "./syntaxes/fastq.tmLanguage.json"
      },
      {
        "language": "vcf",
        "scopeName": "source.vcf",
        "path": "./syntaxes/vcf.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "biomni.activate",
        "title": "Activate Biomni MCP Integration",
        "category": "Biomni",
        "icon": "$(play)"
      },
      {
        "command": "biomni.deactivate",
        "title": "Deactivate Biomni MCP Integration",
        "category": "Biomni",
        "icon": "$(stop)"
      },
      {
        "command": "biomni.database.queryUniprot",
        "title": "Query UniProt Database",
        "category": "Biomni Database",
        "shortTitle": "Query UniProt",
        "icon": "$(database)"
      },
      {
        "command": "biomni.database.queryPDB",
        "title": "Query Protein Data Bank",
        "category": "Biomni Database",
        "shortTitle": "Query PDB",
        "icon": "$(database)"
      },
      {
        "command": "biomni.database.queryAlphaFold",
        "title": "Query AlphaFold Database",
        "category": "Biomni Database",
        "shortTitle": "Query AlphaFold",
        "icon": "$(database)"
      },
      {
        "command": "biomni.database.queryInterPro",
        "title": "Query InterPro Database",
        "category": "Biomni Database",
        "shortTitle": "Query InterPro",
        "icon": "$(database)"
      },
      {
        "command": "biomni.genomics.blastSequence",
        "title": "BLAST Sequence Search",
        "category": "Biomni Genomics",
        "shortTitle": "BLAST Search",
        "icon": "$(search)"
      },
      {
        "command": "biomni.genomics.annotateScRNA",
        "title": "Annotate Single Cell RNA-seq",
        "category": "Biomni Genomics",
        "shortTitle": "scRNA-seq Annotation",
        "icon": "$(microscope)"
      },
      {
        "command": "biomni.genomics.liftoverCoordinates",
        "title": "Liftover Genomic Coordinates",
        "category": "Biomni Genomics",
        "shortTitle": "Coordinate Liftover",
        "icon": "$(arrow-both)"
      },
      {
        "command": "biomni.pharmacology.runDiffDock",
        "title": "Molecular Docking with DiffDock",
        "category": "Biomni Pharmacology",
        "shortTitle": "Molecular Docking",
        "icon": "$(combine)"
      },
      {
        "command": "biomni.pharmacology.predictADMET",
        "title": "Predict ADMET Properties",
        "category": "Biomni Pharmacology",
        "shortTitle": "ADMET Prediction",
        "icon": "$(beaker)"
      },
      {
        "command": "biomni.systems.fluxBalanceAnalysis",
        "title": "Flux Balance Analysis",
        "category": "Biomni Systems Biology",
        "shortTitle": "FBA",
        "icon": "$(graph)"
      },
      {
        "command": "biomni.analysis.proteinDisorderRegions",
        "title": "Predict Protein Disorder Regions",
        "category": "Biomni Proteomics",
        "shortTitle": "Protein Disorder",
        "icon": "$(squiggly)"
      },
      {
        "command": "biomni.analysis.circularDichroism",
        "title": "Analyze Circular Dichroism Spectra",
        "category": "Biomni Analysis",
        "shortTitle": "CD Analysis",
        "icon": "$(graph-line)"
      },
      {
        "command": "biomni.analysis.cellMigration",
        "title": "Analyze Cell Migration Metrics",
        "category": "Biomni Analysis",
        "shortTitle": "Cell Migration",
        "icon": "$(location)"
      },
      {
        "command": "biomni.analysis.atacSeq",
        "title": "ATAC-seq Differential Accessibility",
        "category": "Biomni Genomics",
        "shortTitle": "ATAC-seq Analysis",
        "icon": "$(diff)"
      },
      {
        "command": "biomni.file.validateFormat",
        "title": "Validate Biological File Format",
        "category": "Biomni File Operations",
        "shortTitle": "Validate Format",
        "icon": "$(check)"
      },
      {
        "command": "biomni.file.showInfo",
        "title": "Show File Information",
        "category": "Biomni File Operations",
        "shortTitle": "File Info",
        "icon": "$(info)"
      },
      {
        "command": "biomni.file.suggestTools",
        "title": "Suggest Analysis Tools",
        "category": "Biomni File Operations",
        "shortTitle": "Suggest Tools",
        "icon": "$(lightbulb)"
      },
      {
        "command": "biomni.literature.queryArxiv",
        "title": "Query ArXiv Papers",
        "category": "Biomni Database",
        "shortTitle": "ArXiv Search",
        "icon": "$(book)"
      },
      {
        "command": "biomni.support.runPython",
        "title": "Execute Python Code",
        "category": "Biomni Analysis",
        "shortTitle": "Python REPL",
        "icon": "$(terminal)"
      },
      {
        "command": "biomni.settings.openPanel",
        "title": "Open Settings Panel",
        "category": "Biomni Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "biomni.settings.export",
        "title": "Export Settings",
        "category": "Biomni Settings",
        "icon": "$(export)"
      },
      {
        "command": "biomni.settings.import",
        "title": "Import Settings",
        "category": "Biomni Settings",
        "icon": "$(import)"
      },
      {
        "command": "biomni.settings.reset",
        "title": "Reset to Defaults",
        "category": "Biomni Settings",
        "icon": "$(discard)"
      },
      {
        "command": "biomni.settings.manageApiKeys",
        "title": "Manage API Keys",
        "category": "Biomni Settings",
        "icon": "$(key)"
      },
      {
        "command": "biomni.settings.validateConfiguration",
        "title": "Validate Configuration",
        "category": "Biomni Settings",
        "icon": "$(verified)"
      },
      {
        "command": "biomni.mcp.showStatus",
        "title": "Show MCP Server Status",
        "category": "Biomni MCP",
        "icon": "$(pulse)"
      },
      {
        "command": "biomni.mcp.listTools",
        "title": "List Available Tools",
        "category": "Biomni MCP",
        "icon": "$(tools)"
      },
      {
        "command": "biomni.mcp.testConnection",
        "title": "Test MCP Connection",
        "category": "Biomni MCP",
        "icon": "$(plug)"
      },
      {
        "command": "biomni.mcp.refreshTools",
        "title": "Refresh Tool Discovery",
        "category": "Biomni MCP",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceExtname =~ /\\.(fasta|fa|fas|seq|fna|ffn|frn)$/",
          "command": "biomni.genomics.blastSequence",
          "group": "biomni@1"
        },
        {
          "when": "resourceExtname =~ /\\.(h5|h5ad|csv|xlsx)$/",
          "command": "biomni.genomics.annotateScRNA",
          "group": "biomni@1"
        },
        {
          "when": "resourceExtname =~ /\\.(bed|bedgraph|bw|bigwig)$/",
          "command": "biomni.analysis.atacSeq",
          "group": "biomni@1"
        },
        {
          "when": "resourceExtname =~ /\\.(fasta|fastq|vcf|pdb|gff|gtf|sam|bam|bed)$/",
          "command": "biomni.file.validateFormat",
          "group": "biomni@8"
        },
        {
          "when": "resourceExtname =~ /\\.(fasta|fastq|vcf|pdb|gff|gtf|sam|bam|bed)$/",
          "command": "biomni.file.showInfo",
          "group": "biomni@9"
        },
        {
          "when": "resourceExtname =~ /\\.(fasta|fastq|vcf|pdb|gff|gtf|sam|bam|bed)$/",
          "command": "biomni.file.suggestTools",
          "group": "biomni@10"
        }
      ],
      "editor/context": [
        {
          "when": "resourceExtname =~ /\\.(fasta|fa|fas|seq|fna|ffn|frn)$/",
          "command": "biomni.genomics.blastSequence",
          "group": "biomni@1"
        },
        {
          "when": "resourceExtname =~ /\\.(fasta|fastq|vcf|pdb|gff|gtf|sam|bam|bed)$/",
          "command": "biomni.file.suggestTools",
          "group": "biomni@2"
        }
      ],
      "commandPalette": [
        {
          "command": "biomni.database.queryUniprot",
          "when": "true"
        },
        {
          "command": "biomni.database.queryPDB",
          "when": "true"
        },
        {
          "command": "biomni.database.queryAlphaFold",
          "when": "true"
        },
        {
          "command": "biomni.database.queryInterPro",
          "when": "true"
        },
        {
          "command": "biomni.genomics.blastSequence",
          "when": "true"
        },
        {
          "command": "biomni.genomics.annotateScRNA",
          "when": "true"
        },
        {
          "command": "biomni.genomics.liftoverCoordinates",
          "when": "true"
        },
        {
          "command": "biomni.pharmacology.runDiffDock",
          "when": "true"
        },
        {
          "command": "biomni.pharmacology.predictADMET",
          "when": "true"
        },
        {
          "command": "biomni.systems.fluxBalanceAnalysis",
          "when": "true"
        },
        {
          "command": "biomni.analysis.proteinDisorderRegions",
          "when": "true"
        },
        {
          "command": "biomni.analysis.circularDichroism",
          "when": "true"
        },
        {
          "command": "biomni.analysis.cellMigration",
          "when": "true"
        },
        {
          "command": "biomni.analysis.atacSeq",
          "when": "true"
        },
        {
          "command": "biomni.file.validateFormat",
          "when": "true"
        },
        {
          "command": "biomni.file.showInfo",
          "when": "true"
        },
        {
          "command": "biomni.file.suggestTools",
          "when": "true"
        },
        {
          "command": "biomni.literature.queryArxiv",
          "when": "true"
        },
        {
          "command": "biomni.support.runPython",
          "when": "true"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "biomniProvider",
        "label": "Biomni MCP Server Provider"
      }
    ],
    "configuration": {
      "title": "Biomni MCP Integration",
      "properties": {
        "biomni.extension.core.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Biomni MCP integration"
        },
        "biomni.extension.core.mcpServerUrl": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "MCP server URL",
          "pattern": "^https?://.+"
        },
        "biomni.extension.core.autoActivate": {
          "type": "boolean",
          "default": true,
          "description": "Automatically activate extension on workspace open"
        },
        "biomni.extension.core.debugMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug mode with verbose logging"
        },
        "biomni.extension.core.telemetryEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable anonymous telemetry and usage statistics"
        },
        "biomni.mcp.server.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to Python executable for running MCP server"
        },
        "biomni.mcp.server.scriptPath": {
          "type": "string",
          "default": "",
          "description": "Path to Biomni MCP server script (leave empty for auto-detection)"
        },
        "biomni.mcp.server.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start MCP server when extension activates"
        },
        "biomni.mcp.server.healthCheckInterval": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 300,
          "description": "Health check interval in seconds"
        },
        "biomni.mcp.server.connectionTimeout": {
          "type": "number",
          "default": 10000,
          "minimum": 1000,
          "maximum": 60000,
          "description": "MCP server connection timeout in milliseconds"
        },
        "biomni.mcp.server.maxRetries": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 10,
          "description": "Maximum retry attempts for MCP server operations"
        },
        "biomni.extension.fileDetection.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic biological file type detection"
        },
        "biomni.extension.fileDetection.cacheEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable file detection result caching for better performance"
        },
        "biomni.extension.fileDetection.maxCacheSize": {
          "type": "number",
          "default": 1000,
          "minimum": 10,
          "maximum": 10000,
          "description": "Maximum number of files to cache detection results for"
        },
        "biomni.extension.fileDetection.showSmartSuggestions": {
          "type": "boolean",
          "default": true,
          "description": "Show smart suggestions when opening biological files"
        },
        "biomni.extension.fileDetection.showNewFileNotifications": {
          "type": "boolean",
          "default": false,
          "description": "Show notifications when biological files are detected"
        },
        "biomni.extension.fileDetection.autoValidateFiles": {
          "type": "boolean",
          "default": true,
          "description": "Automatically validate files when opened"
        },
        "biomni.extension.integration.enableCloudSync": {
          "type": "boolean",
          "default": false,
          "description": "Enable cloud synchronization of settings and results"
        },
        "biomni.extension.integration.syncInterval": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 1440,
          "description": "Synchronization interval in minutes"
        },
        "biomni.extension.integration.enableCollaboration": {
          "type": "boolean",
          "default": false,
          "description": "Enable collaborative features for team workspaces"
        },
        "biomni.extension.integration.shareWorkspaceSettings": {
          "type": "boolean",
          "default": false,
          "description": "Share workspace-specific settings with team members"
        },
        "biomni.tools.blast.database": {
          "type": "string",
          "default": "nt",
          "enum": [
            "nt",
            "nr",
            "refseq_genomic",
            "refseq_protein",
            "swissprot",
            "pdb"
          ],
          "description": "Default BLAST database for sequence searches"
        },
        "biomni.tools.blast.eValue": {
          "type": "number",
          "default": 0.01,
          "minimum": 0,
          "maximum": 1,
          "description": "E-value threshold for BLAST searches"
        },
        "biomni.tools.blast.maxTargetSequences": {
          "type": "number",
          "default": 500,
          "minimum": 1,
          "maximum": 10000,
          "description": "Maximum number of target sequences to return"
        },
        "biomni.tools.blast.wordSize": {
          "type": "number",
          "default": 11,
          "minimum": 2,
          "maximum": 50,
          "description": "Word size for BLAST searches"
        },
        "biomni.tools.blast.customOptions": {
          "type": "string",
          "default": "",
          "description": "Custom command-line options for BLAST"
        },
        "biomni.tools.alignment.algorithm": {
          "type": "string",
          "default": "muscle",
          "enum": [
            "clustalw",
            "muscle",
            "mafft",
            "tcoffee"
          ],
          "description": "Default multiple sequence alignment algorithm"
        },
        "biomni.tools.alignment.format": {
          "type": "string",
          "default": "clustal",
          "enum": [
            "clustal",
            "fasta",
            "phylip",
            "nexus"
          ],
          "description": "Output format for sequence alignments"
        },
        "biomni.tools.alignment.gapOpenPenalty": {
          "type": "number",
          "default": -10,
          "minimum": -50,
          "maximum": 0,
          "description": "Gap opening penalty for alignments"
        },
        "biomni.tools.alignment.gapExtensionPenalty": {
          "type": "number",
          "default": -1,
          "minimum": -50,
          "maximum": 0,
          "description": "Gap extension penalty for alignments"
        },
        "biomni.tools.annotation.defaultDatabases": {
          "type": "array",
          "default": [
            "uniprot",
            "go",
            "kegg"
          ],
          "items": {
            "type": "string"
          },
          "description": "Default databases for sequence annotation"
        },
        "biomni.tools.annotation.includeGeneOntology": {
          "type": "boolean",
          "default": true,
          "description": "Include Gene Ontology annotations in results"
        },
        "biomni.tools.annotation.includePathways": {
          "type": "boolean",
          "default": true,
          "description": "Include pathway annotations in results"
        },
        "biomni.tools.annotation.customAnnotationSources": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Custom annotation sources and databases"
        },
        "biomni.display.sequences.maxSequenceLength": {
          "type": "number",
          "default": 10000,
          "minimum": 100,
          "maximum": 1000000,
          "description": "Maximum sequence length to display inline"
        },
        "biomni.display.sequences.showLineNumbers": {
          "type": "boolean",
          "default": true,
          "description": "Show line numbers in sequence displays"
        },
        "biomni.display.sequences.wrapLongSequences": {
          "type": "boolean",
          "default": true,
          "description": "Wrap long sequences for better readability"
        },
        "biomni.display.sequences.highlightGcContent": {
          "type": "boolean",
          "default": false,
          "description": "Highlight GC content in nucleotide sequences"
        },
        "biomni.display.sequences.colorScheme": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "nucleotide",
            "protein",
            "hydrophobicity"
          ],
          "description": "Color scheme for sequence visualization"
        },
        "biomni.display.results.maxResultsPerPage": {
          "type": "number",
          "default": 50,
          "minimum": 10,
          "maximum": 1000,
          "description": "Maximum number of results to show per page"
        },
        "biomni.display.results.showThumbnails": {
          "type": "boolean",
          "default": true,
          "description": "Show thumbnail previews for result files"
        },
        "biomni.display.results.defaultSortOrder": {
          "type": "string",
          "default": "evalue",
          "enum": [
            "relevance",
            "evalue",
            "score",
            "length"
          ],
          "description": "Default sorting order for search results"
        },
        "biomni.display.results.enableInteractiveCharts": {
          "type": "boolean",
          "default": true,
          "description": "Enable interactive charts and visualizations"
        },
        "biomni.display.ui.theme": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "description": "UI theme preference (auto follows VSCode theme)"
        },
        "biomni.display.ui.fontSize": {
          "type": "number",
          "default": 14,
          "minimum": 8,
          "maximum": 24,
          "description": "Font size for Biomni interfaces"
        },
        "biomni.display.ui.showWelcomeScreen": {
          "type": "boolean",
          "default": true,
          "description": "Show welcome screen on first activation"
        },
        "biomni.display.ui.enableNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Enable system notifications for important events"
        },
        "biomni.performance.cache.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable result caching for improved performance"
        },
        "biomni.performance.cache.size": {
          "type": "number",
          "default": 256,
          "minimum": 10,
          "maximum": 10240,
          "description": "Cache size in MB"
        },
        "biomni.performance.cache.ttl": {
          "type": "number",
          "default": 3600,
          "minimum": 300,
          "maximum": 86400,
          "description": "Cache time-to-live in seconds"
        },
        "biomni.performance.cache.maxFiles": {
          "type": "number",
          "default": 1000,
          "minimum": 10,
          "maximum": 100000,
          "description": "Maximum number of files to cache"
        },
        "biomni.performance.processing.maxConcurrentJobs": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 32,
          "description": "Maximum number of concurrent processing jobs"
        },
        "biomni.performance.processing.timeoutDuration": {
          "type": "number",
          "default": 300,
          "minimum": 30,
          "maximum": 3600,
          "description": "Job timeout duration in seconds"
        },
        "biomni.performance.processing.enableParallelProcessing": {
          "type": "boolean",
          "default": true,
          "description": "Enable parallel processing for large datasets"
        },
        "biomni.performance.processing.chunkSize": {
          "type": "number",
          "default": 1000,
          "minimum": 100,
          "maximum": 100000,
          "description": "Chunk size for parallel processing"
        },
        "biomni.performance.memory.maxMemoryUsage": {
          "type": "number",
          "default": 512,
          "minimum": 64,
          "maximum": 8192,
          "description": "Maximum memory usage in MB"
        },
        "biomni.performance.memory.enableGarbageCollection": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic garbage collection"
        },
        "biomni.performance.memory.gcThreshold": {
          "type": "number",
          "default": 256,
          "minimum": 32,
          "maximum": 4096,
          "description": "Memory threshold for garbage collection in MB"
        },
        "biomni.security.privacy.enableDataRetention": {
          "type": "boolean",
          "default": true,
          "description": "Enable data retention for caching and history"
        },
        "biomni.security.privacy.retentionPeriod": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 365,
          "description": "Data retention period in days"
        },
        "biomni.security.privacy.shareUsageStatistics": {
          "type": "boolean",
          "default": false,
          "description": "Share anonymous usage statistics to improve the extension"
        },
        "biomni.security.privacy.enableAuditLogging": {
          "type": "boolean",
          "default": false,
          "description": "Enable audit logging for security monitoring"
        },
        "biomni.security.external.allowedHosts": {
          "type": "array",
          "default": [
            "ncbi.nlm.nih.gov",
            "uniprot.org",
            "ensembl.org"
          ],
          "items": {
            "type": "string"
          },
          "description": "Allowed hosts for external API calls"
        },
        "biomni.security.external.enableSslVerification": {
          "type": "boolean",
          "default": true,
          "description": "Enable SSL certificate verification for external connections"
        },
        "biomni.security.external.useProxy": {
          "type": "boolean",
          "default": false,
          "description": "Use proxy server for external connections"
        },
        "biomni.security.external.proxyUrl": {
          "type": "string",
          "default": "",
          "description": "Proxy server URL (if proxy is enabled)"
        },
        "biomni.workflows.templates.defaultWorkflows": {
          "type": "array",
          "default": [
            "sequence-analysis",
            "variant-calling",
            "genome-annotation"
          ],
          "items": {
            "type": "string"
          },
          "description": "Default workflow templates to load"
        },
        "biomni.workflows.templates.customWorkflows": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Custom workflow templates created by user"
        },
        "biomni.workflows.templates.autoSaveWorkflows": {
          "type": "boolean",
          "default": true,
          "description": "Automatically save workflow modifications"
        },
        "biomni.workflows.execution.defaultEnvironment": {
          "type": "string",
          "default": "local",
          "enum": [
            "local",
            "remote",
            "cloud"
          ],
          "description": "Default execution environment for workflows"
        },
        "biomni.workflows.execution.retryAttempts": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 10,
          "description": "Number of retry attempts for failed workflow steps"
        },
        "biomni.workflows.execution.enableLogging": {
          "type": "boolean",
          "default": true,
          "description": "Enable detailed logging for workflow execution"
        },
        "biomni.workflows.execution.logLevel": {
          "type": "string",
          "default": "info",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "description": "Logging level for workflow execution"
        },
        "biomni.internal.settingsVersion": {
          "type": "string",
          "default": "0.0.1",
          "description": "Internal settings schema version (do not modify)"
        }
      }
    },
    "keybindings": [
      {
        "command": "biomni.database.queryUniprot",
        "key": "ctrl+shift+u",
        "when": "editorTextFocus"
      },
      {
        "command": "biomni.genomics.blastSequence",
        "key": "ctrl+shift+b",
        "when": "resourceExtname =~ /\\.(fasta|fa|fas|seq|fna|ffn|frn)$/"
      },
      {
        "command": "biomni.pharmacology.runDiffDock",
        "key": "ctrl+shift+d",
        "when": "editorTextFocus"
      },
      {
        "command": "biomni.file.validateFormat",
        "key": "ctrl+shift+v",
        "when": "resourceExtname =~ /\\.(fasta|fastq|vcf|pdb|gff|gtf|sam|bam|bed)$/"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "package": "vsce package",
    "build": "npm run compile",
    "dev": "npm run watch"
  },
